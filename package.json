{
  "name": "opencode-diff",
  "displayName": "OpenCode Diff",
  "description": "Runs opencode and presents the changes in diff views to accept or reject, like Copilot.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.127.0"
  },
  "main": "./dist/extension.js",
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguageModelChatProvider:opencode"
  ],
  "contributes": {
    "chatParticipants": [
      {
        "id": "opencodeDiff.chat",
        "name": "opencode",
        "fullName": "OpenCode",
        "description": "Runs opencode in your workspace and offers the changes as diffs to accept or reject.",
        "isSticky": true,
        "commands": [
          {
            "name": "review",
            "description": "Runs a request with opencode then opens the review of the proposed diffs."
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencodeDiff",
          "title": "OpenCode Diff",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "opencodeDiff": [
        {
          "type": "tree",
          "id": "opencodeDiff.review",
          "name": "Change review"
        }
      ]
    },
    "languageModelChatProviders": [
      {
        "vendor": "opencode",
        "displayName": "OpenCode",
        "managementCommand": "opencodeDiff.refreshModels"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "opencodeDiff.acceptAll",
          "when": "view == opencodeDiff.review && opencodeDiff.hasReview",
          "group": "navigation@1"
        },
        {
          "command": "opencodeDiff.rejectAll",
          "when": "view == opencodeDiff.review && opencodeDiff.hasReview",
          "group": "navigation@2"
        },
        {
          "command": "opencodeDiff.clearReview",
          "when": "view == opencodeDiff.review && opencodeDiff.hasReview",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "opencodeDiff.acceptActiveDiff",
          "when": "opencodeDiff.activeDiff",
          "group": "navigation@1"
        },
        {
          "command": "opencodeDiff.rejectActiveDiff",
          "when": "opencodeDiff.activeDiff",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "opencodeDiff.openChange",
          "when": "view == opencodeDiff.review && viewItem == opencodeDiff.reviewFile",
          "group": "inline@1"
        },
        {
          "command": "opencodeDiff.acceptChange",
          "when": "view == opencodeDiff.review && viewItem == opencodeDiff.reviewFile",
          "group": "inline@2"
        },
        {
          "command": "opencodeDiff.rejectChange",
          "when": "view == opencodeDiff.review && viewItem == opencodeDiff.reviewFile",
          "group": "inline@3"
        }
      ],
      "commandPalette": []
    },
    "commands": [
      {
        "command": "opencodeDiff.acceptAll",
        "title": "Accept All",
        "category": "OpenCode Diff",
        "icon": "$(check-all)"
      },
      {
        "command": "opencodeDiff.rejectAll",
        "title": "Reject All",
        "category": "OpenCode Diff",
        "icon": "$(close-all)"
      },
      {
        "command": "opencodeDiff.clearReview",
        "title": "Discard Review",
        "category": "OpenCode Diff",
        "icon": "$(trash)"
      },
      {
        "command": "opencodeDiff.focusReview",
        "title": "Open Change Review",
        "category": "OpenCode Diff",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "opencodeDiff.openChange",
        "title": "Open Diff",
        "category": "OpenCode Diff",
        "icon": "$(git-compare)"
      },
      {
        "command": "opencodeDiff.acceptChange",
        "title": "Accept File",
        "category": "OpenCode Diff",
        "icon": "$(check)"
      },
      {
        "command": "opencodeDiff.rejectChange",
        "title": "Reject File",
        "category": "OpenCode Diff",
        "icon": "$(discard)"
      },
      {
        "command": "opencodeDiff.acceptActiveDiff",
        "title": "Accept File",
        "category": "OpenCode Diff",
        "icon": "$(check)"
      },
      {
        "command": "opencodeDiff.rejectActiveDiff",
        "title": "Reject File",
        "category": "OpenCode Diff",
        "icon": "$(discard)"
      },
      {
        "command": "opencodeDiff.refreshModels",
        "title": "Refresh Models",
        "category": "OpenCode Diff",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "OpenCode Diff",
      "properties": {
        "opencodeDiff.opencodePath": {
          "type": "string",
          "default": "opencode",
          "description": "Path to the opencode binary. Defaults to 'opencode' (resolved via PATH, then ~/.opencode/bin)."
        },
        "opencodeDiff.model": {
          "type": "string",
          "default": "",
          "description": "Model to use in provider/model format (e.g. anthropic/claude-sonnet-4-5). Empty = opencode's default model."
        },
        "opencodeDiff.agent": {
          "type": "string",
          "default": "",
          "description": "opencode agent to use. Empty = default agent."
        },
        "opencodeDiff.autoOpenReview": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the review view when a run produces changes."
        },
        "opencodeDiff.allowBash": {
          "type": "boolean",
          "default": false,
          "description": "Allow opencode to run bash commands. Disabled by default: side effects (installations, servers) are not reversible by the review."
        },
        "opencodeDiff.webfetchPermission": {
          "type": "string",
          "enum": [
            "allow",
            "deny"
          ],
          "default": "allow",
          "description": "Allow opencode to fetch web pages."
        },
        "opencodeDiff.snapshotSizeLimitMb": {
          "type": "number",
          "default": 10,
          "description": "Maximum size (MB) of files kept for restoration. Larger files modified by opencode cannot be restored automatically."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package --no-dependencies",
    "compile": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node esbuild-test.mjs && node --test 'dist-test/*.test.mjs'",
    "check": "npm run compile"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.16",
    "diff": "^7.0.0",
    "ignore": "^6.0.2"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vscode-uri": "^3.1.0"
  }
}
